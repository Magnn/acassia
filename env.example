# Copie para .env e preencha. Valores abaixo são exemplos — não use em produção sem revisão.
#
# Dependências Python: pip install -r requirements.txt

# ── Negócio / wizard (opcional) ──
# NEGOCIO_SLUG=cigana_piloto
# NEGOCIO_NOME=Cigana Esmeralda
# NEGOCIO_VERTICAL=consultoria_mistica
# NEGOCIO_OFERTA_RESUMO=Leitura guiada + ritual no WhatsApp
# NEGOCIO_PUBLICO=Pessoas em crise afetiva buscando clareza
# NEGOCIO_PROMESSA=Clareza simbólica e acolhimento honesto — sem substituir saúde mental profissional
# NEGOCIO_NAO_E=Quem espera milagre instantâneo ou substituto de terapia
# NEGOCIO_PROVA_CURTA=Instagram + depoimentos reais

# ── Pontes de copy (sobrescrevem defaults do config_cliente) ──
# PONTE_PRECO_FORA_ORDEM=
# PONTE_DESCONFIANCA=
# PONTE_MULTI_TOPICO=

# ── Guardrails de copy (lista separada por vírgula) ──
# COPY_EVITAR_TOM=URGENTE HOJE,última chance,garantido 100%
# COPY_NAO_PROMETER=cura de doença,substituto médico,garantia financeira

# ── Compliance (referência — motor já limita recovery) ──
# COMPLIANCE_MAX_RECOVERY_CICLOS=3
# COMPLIANCE_MIN_MIN_ENTRE_RECOVERY=5

# ── Links (use sempre o checkout e o Instagram DO cliente — lidos em config_cliente.py) ──
# Checkout por faixa (R$) — alinha com teste A/B do node 8 (lead_id % 3 → 130 / 100 / 65).
# Prioridade no envio: URL desta faixa > API Cakto (se habilitada) > LINK_CHECKOUT.
# Se LINK_CHECKOUT estiver vazio, link_pagamento genérico usa 130, depois 100, depois 65.
# CHECKOUT_URL_130=https://pay.cakto.com.br/...
# CHECKOUT_URL_100=https://pay.cakto.com.br/...
# CHECKOUT_URL_65=https://pay.cakto.com.br/...
# Opcional (negociação): CHECKOUT_URL_50=  CHECKOUT_URL_40=  CHECKOUT_URL_30=
# LINK_CHECKOUT=https://pay.seudominio.com.br/...
# CHECKOUT_URL=
# CAKTO_CHECKOUT_URL=
# CLIENTE_LINK_PAGAMENTO=
# LINK_INSTAGRAM=https://www.instagram.com/seu_perfil/
# CLIENTE_LINK_PROVA_SOCIAL=
# INSTAGRAM_URL=
# URL_INSTAGRAM=
# CLIENTE_IMAGEM_PERFIL_INSTAGRAM=https://seu-cdn.com/instagram-perfil.jpg
# IMAGEM_PERFIL_INSTAGRAM_URL=
# CLIENTE_LINK_DOWNSELL=

# ── Sentry (opcional): observabilidade de erros em produção ──
# SENTRY_DSN=https://xxx@o0.ingest.sentry.io/0
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Redis (opcional): fila durável webhook WhatsApp → triagem (LPUSH/BRPOP). Sem REDIS_URL = só thread in-process.
# Produção (Upstash — serverless, TLS, gratuito até 10k req/dia):
#   1. Crie conta em https://console.upstash.com
#   2. New Database → região South America (São Paulo)
#   3. Copie a "Redis URL" do painel (começa com rediss://)
# REDIS_URL=rediss://default:SUA_SENHA@seu-host.upstash.io:6379
#
# Dev local (Redis local sem TLS):
# REDIS_URL=redis://localhost:6379/0
#
REDIS_INBOUND_QUEUE_KEY=cigana:wa:inbound
# REDIS_BRPOP_TIMEOUT=10
# REDIS_SOCKET_TIMEOUT=10

# ── Fila / inbox (debounce, concorrência, reintentos busy) — defaults em config_cliente.py ──
# INBOX_MAX_CONCORRENCIA_PROCESSAMENTO=24
# INBOX_MAX_RETRIES_BUSY=8
# INBOX_MAX_TAMANHO_FILA_POR_LEAD=96
# INBOX_COALESCE_SECONDS=3
# INBOX_SILENCE_SECONDS=25
# INBOX_AFTER_TEXT_GRACE_SECONDS=20
# INBOX_AFTER_TEXT_GRACE_MIN_CHARS=40
# Aviso "node lento" no log (engine) — nodes com IA costumam ultrapassar 3.5s
# NODE_EXEC_SLA_WARN_SECONDS=6

# ── Flow Builder (execute / flow_executor) ──
# Pedidos HTTP dos nós "API Request" em "Executar lead": desligado por defeito (segurança).
# FLOW_BLUEPRINT_ALLOW_HTTP=1
# Blocos GPT / Agente IA: chamar Gemini ao executar o fluxo (requer GEMINI_API_KEY no processo).
# FLOW_BLUEPRINT_ALLOW_LLM=1
# Opcional: modelo por defeito se o bloco não definir (ver dashboard).
# FLOW_BLUEPRINT_LLM_DEFAULT_MODEL=gemini-2.5-flash
# FLOW_BLUEPRINT_LLM_MAX_OUTPUT_TOKENS=1024
# FLOW_BLUEPRINT_LLM_TIMEOUT_S=45
# Bloco "Referência motor Python": executar função list[Acao] (allowlist de prefixos de módulo).
# FLOW_BLUEPRINT_ALLOW_MOTOR_REF=1
# FLOW_BLUEPRINT_MOTOR_REF_ALLOWLIST=flows.flow_blueprint_motor

# ── Flow Builder (UI) ──
# Quando ativo (e frontend/dist existe), /dashboard redireciona pra /builder/.
# Bypass por requisição via ?legacy=1 (mantém o dashboard.html como fallback).
# Build React: cd frontend && npm install && npm run build
# FLOW_BUILDER_REACT=1
